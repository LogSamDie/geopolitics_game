{
  // Python: the interpreter from `uv sync`, imports resolved from backend/, pytest from there too.
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/bin/python",
  "python.analysis.extraPaths": ["backend"],
  "python.testing.pytestEnabled": true,
  "python.testing.cwd": "${workspaceFolder}/backend",
  "python.testing.pytestArgs": ["tests"],
  "mypy-type-checker.cwd": "${workspaceFolder}/backend",
  "mypy-type-checker.args": ["--config-file", "pyproject.toml"],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": { "source.organizeImports": "explicit" }
  },
  // Frontend: Prettier (with the Svelte plugin from frontend/node_modules) formats on save.
  "prettier.configPath": "frontend/.prettierrc",
  "[svelte]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "editor.formatOnSave": true },
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "editor.formatOnSave": true },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[yaml]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "files.exclude": { "**/__pycache__": true, "**/.mypy_cache": true, "**/.ruff_cache": true, "**/.pytest_cache": true }
}
